{
  "name": "versora",
  "version": "1.0.44",
  "description": "Versora — a focused comparison workspace for files, workbooks, Git, and SVN",
  "author": "ClearLotus",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClearLotus001/Versora.git"
  },
  "scripts": {
    "dev": "tsx scripts/dev-app.ts",
    "dev:app": "tsx scripts/dev-app.ts",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:run": "tsx scripts/dev-electron-runner.ts",
    "generate:installer-assets": "tsx scripts/generate-installer-assets.ts",
    "generate:shiki-registry": "tsx scripts/generate-shiki-language-registry.ts",
    "generate:i18n-param-keys": "tsx scripts/generate-i18n-param-keys.ts",
    "lint": "npm run lint:eslint && npm run lint:exports",
    "lint:eslint": "eslint src electron scripts shared --max-warnings=0",
    "lint:exports": "tsx scripts/check-unused-exports.ts",
    "lint:rust": "tsx scripts/lint-rust.ts",
    "lint:rust:fmt": "tsx scripts/lint-rust.ts fmt",
    "lint:rust:clippy": "tsx scripts/lint-rust.ts clippy",
    "verify:static": "npm run lint && npm run typecheck",
    "verify:rust": "npm run build:rust && npm run lint:rust",
    "build": "npm run typecheck && npm run build:rust && npm run build:app",
    "build:app": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:rust": "tsx scripts/build-rust.ts",
    "benchmark:perf": "tsx scripts/benchmark-diff-performance.ts",
    "benchmark:perf:ci": "tsx scripts/benchmark-diff-performance.ts --ci --iterations=1",
    "build:win:installer": "npm run generate:installer-assets && npm run build && tsx scripts/build-win-installer.ts",
    "build:win": "npm run build:win:installer",
    "build:win:release": "npm run build:win",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron && npm run typecheck:scripts && npm run typecheck:tests",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run test:workbook",
    "test:workbook": "tsx scripts/ensure-rust-artifacts.ts && tsx scripts/run-workbook-tests.ts",
    "test:workbook:unit": "tsx scripts/run-workbook-tests.ts --skip-rust-required",
    "test:workbook:rust": "tsx scripts/ensure-rust-artifacts.ts && tsx scripts/run-workbook-tests.ts --only-rust-required",
    "test:workbook:js": "npm run test:workbook:unit",
    "test:workbook:search": "tsx --test tests/workbook-search-navigation.test.ts tests/workbook-selection-visual.test.ts",
    "verify:ci": "npm run verify:static && npm run verify:rust && npm run test:workbook:unit && npm run test:workbook:rust && npm run build:app",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "verify:install-upgrade": "tsx scripts/verify-install-upgrade.ts",
    "verify:single-instance-cache": "tsx scripts/verify-single-instance-cache.ts",
    "report:package-sizes": "tsx scripts/report-package-sizes.ts",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.versora.app",
    "productName": "Versora",
    "artifactName": "${productName}-${version}.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "Versora"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ClearLotus001",
        "repo": "Versora",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "!**/node_modules/js-yaml/bin/**",
      "!**/node_modules/js-yaml/dist/**",
      "!**/node_modules/argparse/**",
      "!**/node_modules/fast-xml-parser/src/**",
      "!**/node_modules/fast-xml-parser/lib/*.min.js",
      "!**/node_modules/fast-xml-parser/lib/*.min.js.map",
      "!**/node_modules/fast-xml-parser/lib/*.d.cts",
      "!**/node_modules/fast-xml-builder/src/**",
      "!**/node_modules/fast-xml-builder/lib/*.min.js",
      "!**/node_modules/fast-xml-builder/lib/*.min.js.map",
      "!**/node_modules/fast-xml-builder/lib/*.d.cts",
      "!**/node_modules/path-expression-matcher/src/**",
      "!**/node_modules/path-expression-matcher/lib/*.min.js",
      "!**/node_modules/path-expression-matcher/lib/*.min.js.map",
      "!**/node_modules/path-expression-matcher/lib/*.d.cts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "rust/target/release/svn_excel_parser.exe",
        "to": "bin/svn_excel_parser.exe"
      },
      {
        "from": "rust/target/release/svn_diff_launcher.exe",
        "to": "bin/svn_diff_launcher.exe"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "installerHeader": null,
      "installerSidebar": "installerSidebar.bmp",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@shikijs/core": "^4.0.2",
    "@shikijs/engine-javascript": "^4.0.2",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@shikijs/types": "^4.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fflate": "^0.8.2",
    "globals": "^17.4.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.5",
    "zustand": "^5.0.12"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.5.10",
    "framer-motion": "^12.42.2"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
